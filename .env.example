# ---------------------------------------------------------------------------
# Receiving Manager — environment configuration
# Copy to .env.local for local development. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by the seed script and by server routes that must write
# audit rows. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini (https://aistudio.google.com/apikey — free tier)
# Server-only. Never expose to the browser.
GEMINI_API_KEY=your-gemini-api-key

# Model id is configurable. Use a currently available multimodal model.
GEMINI_MODEL=gemini-3.8-flash

# ---- Quota / cost protection (all optional, values below are defaults) ----
# Maximum inspections per organisation per UTC day.
INSPECTION_DAILY_LIMIT=100
# Milliseconds before a model call is aborted and the record is set to pending.
INSPECTION_TIMEOUT_MS=60000
# Maximum images accepted in a single inspection.
MAX_IMAGES_PER_INSPECTION=8
# Maximum accepted upload size per image, in bytes (8 MB).
MAX_IMAGE_BYTES=8388608
# Maximum automatic retry attempts per receiving record.
MAX_INSPECTION_ATTEMPTS=3

# Storage bucket name for private receiving evidence.
SUPABASE_STORAGE_BUCKET=receiving-evidence

# Only for npm run seed (demo operator accounts)
SEED_DEMO_PASSWORD=
